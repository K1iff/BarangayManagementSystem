@model BarangayLangkiwaSystem.Models.UserAccounts

@{
    ViewData["Title"] = "Create Account";
    Layout = "_AuthLayout";
}

<div class="card border-0 shadow-lg p-4 p-md-5 rounded-4 bg-white">
    <h3 class="fw-bold text-center mb-4 text-dark">Create Account</h3>

    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="username" class="form-label small fw-bold"></label>
            <input asp-for="username" class="form-control" />
            <span asp-validation-for="username" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="password" class="form-label small fw-bold"></label>
            <input asp-for="password" type="password" class="form-control" />
            <span asp-validation-for="password" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="staff_name" class="form-label small fw-bold"></label>
            <input asp-for="staff_name" class="form-control" />
            <span asp-validation-for="staff_name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="role" class="form-label small fw-bold"></label>
            <select asp-for="role" class="form-select">
                <option value="">-- Select Role --</option>
                <option>Clerk</option>
                <option>Secretary</option>
                <option>Barangay Captain</option>
            </select>
            <span asp-validation-for="role" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-success w-100 fw-bold py-2">
            Register
        </button>

        <div class="text-center mt-3">
            <a asp-action="Login" class="btn btn-outline-secondary w-100">
                Back to Login
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
