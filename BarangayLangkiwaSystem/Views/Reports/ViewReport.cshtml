@{
    ViewData["Title"] = "Generated Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Generate" class="text-decoration-none text-muted">
            <i class="bi bi-chevron-left me-2"></i>Back to Reports
        </a>
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm px-3"><i class="bi bi-file-earmark-excel me-2"></i>Export to Excel</button>
            <button class="btn btn-info btn-sm px-3 text-white"><i class="bi bi-file-earmark-pdf me-2"></i>Export to PDF</button>
            <button class="btn btn-secondary btn-sm px-3" onclick="window.print()"><i class="bi bi-printer me-2"></i>Print</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="p-3 d-flex justify-content-between align-items-center">
                <div class="input-group w-25">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Search..." />
                </div>
                <div class="small">
                    Page <strong>1 of 300</strong>
                    <a href="#" class="ms-2 text-primary text-decoration-none">Next <i class="bi bi-chevron-right"></i></a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="bg-light">
                        <tr class="small text-center">
                            <th>Purok / Zone</th>
                            <th>Total Residents</th>
                            <th>Male Residents</th>
                            <th>Female Residents</th>
                            <th>Total Household</th>
                            <th>PWDs</th>
                            <th>Registered Voters</th>
                            <th>New Residents</th>
                        </tr>
                    </thead>
                    <tbody class="text-center small">
                        <tr><td>Purok 1</td><td>248</td><td>121</td><td>127</td><td>56</td><td>7</td><td>210</td><td>67</td></tr>
                        <tr><td>Purok 2</td><td>460</td><td>215</td><td>245</td><td>67</td><td>18</td><td>316</td><td>23</td></tr>
                        <tr><td>Purok 3</td><td>325</td><td>158</td><td>167</td><td>72</td><td>12</td><td>268</td><td>41</td></tr>
                        <tr><td>Purok 4</td><td>392</td><td>189</td><td>203</td><td>84</td><td>15</td><td>301</td><td>52</td></tr>
                        <tr><td>Purok 5</td><td>287</td><td>142</td><td>145</td><td>63</td><td>9</td><td>234</td><td>38</td></tr>
                        <tr><td>Purok 6</td><td>418</td><td>206</td><td>212</td><td>91</td><td>21</td><td>345</td><td>29</td></tr>
                        <tr><td>Purok 7</td><td>351</td><td>173</td><td>178</td><td>78</td><td>14</td><td>289</td><td>47</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3 border-0">
            <div class="row small text-muted">
                <div class="col">Report Generated On: <strong>November 01, 2026</strong></div>
                <div class="col text-end">Generated by: <strong>Secretary</strong></div>
            </div>
        </div>
    </div>
</div>