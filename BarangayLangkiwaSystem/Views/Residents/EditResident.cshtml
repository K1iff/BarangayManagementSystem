@model BarangayLangkiwaSystem.Models.Resident

@{
    ViewData["Title"] = "Edit Resident";
}

<style>
    input[readonly], select[disabled] {
        background-color: #e9ecef; /* Light gray background */
        cursor: not-allowed;      /* Shows a 'block' icon on hover */
    }
</style>

<div class="container-fluid">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-bottom">
            <h4 class="m-0 fw-bold text-dark">Edit Resident Information</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="ResidentId" />

                
                <div class="row mb-4">
                    <div class="col-md-3">
                        <label asp-for="FirstName" class="form-label small fw-bold"></label>
                        <input asp-for="FirstName" class="form-control" readonly="readonly" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MiddleName" class="form-label small fw-bold"></label>
                        <input asp-for="MiddleName" class="form-control" readonly="readonly" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="LastName" class="form-label small fw-bold"></label>
                        <input asp-for="LastName" class="form-control" readonly="readonly" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Suffix" class="form-label small fw-bold"></label>
                        <input asp-for="Suffix" class="form-control" readonly="readonly" />
                        <span asp-validation-for="Suffix" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Birthdate" class="form-label small fw-bold"></label>
                        <input asp-for="Birthdate" class="form-control" type="date" readonly="readonly" />
                        <span asp-validation-for="Birthdate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label small fw-bold"></label>
                        <select asp-for="Gender" class="form-control">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CivilStatus" class="form-label small fw-bold"></label>
                         <select asp-for="CivilStatus" class="form-control">
                            <option value="">Select Civil Status</option>
                            <option value="Single">Single</option>
                            <option value="Married">Married</option>
                            <option value="Divorced">Divorced</option>
                            <option value="Widowed">Widowed</option>
                            <option value="Separated">Separated</option>
                        </select>
                        <span asp-validation-for="CivilStatus" class="text-danger small"></span>
                    </div>
                </div>

                <h6 class="text-primary fw-bold border-bottom pb-2 mb-3">Contact & Other Information</h6>
                <div class="row mb-4">
                    <div class="col-md-4">
                        <label asp-for="ContactNo" class="form-label small fw-bold"></label>
                        <input asp-for="ContactNo" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EmergencyContactName" class="form-label small fw-bold"></label>
                        <input asp-for="EmergencyContactName" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EmergencyContactNo" class="form-label small fw-bold"></label>
                        <input asp-for="EmergencyContactNo" class="form-control" />
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Email" class="form-label small fw-bold"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Occupation" class="form-label small fw-bold"></label>
                        <input asp-for="Occupation" class="form-control" />
                    </div>
                    <div class="col-md-5 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="IsMigrant" class="form-check-input" type="checkbox" />
                            <label asp-for="IsMigrant" class="form-check-label small fw-bold"></label>
                        </div>
                    </div>
                </div>

                <h6 class="text-primary fw-bold border-bottom pb-2 mb-3">Address Information</h6>
                <div class="row mb-4">
                    <div class="col-md-8">
                        <label asp-for="Address" class="form-label small fw-bold"></label>
                        <input asp-for="Address" class="form-control" readonly="readonly" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Purok" class="form-label small fw-bold"></label>
                        <select asp-for="Purok" class="form-control" readonly="readonly" />
                            <option value="Purok 1">Purok 1</option>
                            <option value="Purok 2">Purok 2</option>
                            <option value="Purok 3">Purok 3</option>
                            <option value="Purok 4">Purok 4</option>
                        </select>
                    </div>
                </div>

         

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-success px-4">Update Resident</button>
                </div>
            </form>
        </div>
    </div>
</div>
