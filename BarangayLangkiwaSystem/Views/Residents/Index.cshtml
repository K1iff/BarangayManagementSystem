@model IEnumerable<BarangayLangkiwaSystem.Models.Resident>

@{
    ViewData["Title"] = "Resident Information";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0 text-dark">Resident Information</h2>
        <a asp-action="Register" class="btn btn-primary px-4 shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i>Register New Resident
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-light p-3 me-3 text-primary">
                        <i class="bi bi-person-fill" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">Total Registered Residents</small>
                        <h3 class="fw-bold m-0">@ViewBag.TotalRegistered</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-light p-3 me-3 text-primary">
                        <i class="bi bi-check-circle-fill" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">Active Voters Registered</small>
                        <h3 class="fw-bold m-0">@ViewBag.ActiveVoters</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-light p-3 me-3 text-success">
                        <i class="bi bi-clock-fill" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">New Residents (Last Month)</small>
                        <h3 class="fw-bold m-0">@ViewBag.NewResidents</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-light p-3 me-3 text-warning">
                        <i class="bi bi-house-door-fill" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">Total Households</small>
                        <h3 class="fw-bold m-0">@ViewBag.TotalHouseholds</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3">
            <ul class="nav nav-tabs card-header-tabs border-0">
                <li class="nav-item">
                    <a class="nav-link active border-0 fw-bold" href="#">All Residents</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted border-0" href="#">Active Voters</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted border-0" href="#">Recent Registrations</a>
                </li>
            </ul>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase text-muted">
                            <th class="ps-4">Resident ID</th>
                            <th>Full Name</th>
                            <th>Age</th>
                            <th>Address</th>
                            <th>Registration Date</th>
                            <th>Voter Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">R-2025-00@(item.ResidentId)</td>
                                <td class="fw-bold text-dark">@item.FirstName @item.LastName</td>
                                <td>@item.Age</td>
                                <td class="small text-muted">@item.Address</td>
                                <td>@item.DateRegistered.ToString("MM/dd/yyyy")</td>
                                <td>
                                    @if (item.VoterStatus == "Active")
                                    {
                                        <span class="badge bg-primary px-3 py-2 rounded-pill">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">Not Voter</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-sm btn-primary px-3">View</button>
                                        <button class="btn btn-sm btn-success px-3">Edit</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3 border-0 text-end">
            <small class="text-muted pe-3">Page 1 of 300</small>
        </div>
    </div>
</div>