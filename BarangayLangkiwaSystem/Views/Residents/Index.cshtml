@model List<BarangayLangkiwaSystem.Models.Resident>

@{
    ViewData["Title"] = "Resident Information";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0 text-dark">Resident Information</h2>
        <a asp-action="Register" class="btn btn-primary px-4 shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i>Register New Resident
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-light p-3 me-3 text-primary">
                        <i class="bi bi-person-fill" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">Total Registered Residents</small>
                        <h3 class="fw-bold m-0">@ViewBag.TotalRegistered</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-light p-3 me-3 text-primary">
                        <i class="bi bi-check-circle-fill" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">Active Voters Registered</small>
                        <h3 class="fw-bold m-0">@ViewBag.ActiveVoters</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-light p-3 me-3 text-success">
                        <i class="bi bi-clock-fill" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">New Residents (Last Month)</small>
                        <h3 class="fw-bold m-0">@ViewBag.NewResidents</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-light p-3 me-3 text-warning">
                        <i class="bi bi-house-door-fill" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">Total Households</small>
                        <h3 class="fw-bold m-0">@ViewBag.TotalHouseholds</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="row g-3 mb-4">
            </div>

        <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <form method="get" asp-action="Index" class="d-flex">
                                <input type="hidden" name="filter" value="@ViewBag.Filter">
                                <input type="text" name="searchString" class="form-control me-2" placeholder="Search by name..." value="@ViewBag.SearchString">
                                <button class="btn btn-primary" type="submit">Search</button>
                            </form>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <form method="get" asp-action="Index" class="d-inline-block">
                                <input type="hidden" name="searchString" value="@ViewBag.SearchString">
                                <select name="filter" class="form-select" onchange="this.form.submit()">
                                    <option value="All" selected="@(ViewBag.Filter == "All")">All Time</option>
                                    <option value="Today" selected="@(ViewBag.Filter == "Today")">Today</option>
                                    <option value="Week" selected="@(ViewBag.Filter == "Week")">This Week</option>
                                    <option value="Month" selected="@(ViewBag.Filter == "Month")">This Month</option>
                                    <option value="LastMonth" selected="@(ViewBag.Filter == "LastMonth")">Last Month</option>
                                </select>
                            </form>
                        </div>
                    </div>
                </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase text-muted">
                            <th class="ps-4">Resident ID</th>
                            <th>Full Name</th>
                            @*<th>Age</th>
                            <th>Address</th>
                            <th>Registration Date</th>
                            <th>Voter Status</th>*@
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(r => r.LastName).ThenBy(r => r.FirstName))
                        {
                            <tr>
                                <td class="ps-4 text-muted small">R-2025-00@(item.ResidentId)</td>
                                <td class="fw-bold text-dark">@item.FirstName @item.LastName @item.Suffix</td>
                                @*<td>@item.Age</td>
                                <td class="small text-muted">@item.Address</td>
                                <td>@item.DateRegistered.ToString("MM/dd/yyyy")</td>
                                <td>
                                    @if (item.VoterStatus == "Active")
                                    {
                                        <span class="badge bg-primary px-3 py-2 rounded-pill">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">Not Voter</span>
                                    }
                                </td>*@
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="View" asp-route-id="@item.ResidentId" class="btn btn-sm btn-primary px-3">View</a>
                                        <a asp-action="Edit" asp-route-id="@item.ResidentId" class="btn btn-sm btn-success px-3">Edit</a>
                                       
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3 border-0">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted ps-2">
                    Showing @(Model.Count > 0 ? (ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1 : 0) to @Math.Min((int)ViewBag.CurrentPage * (int)ViewBag.PageSize, (int)ViewBag.TotalCount) of @ViewBag.TotalCount residents
                </small>

                <nav aria-label="Residents pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(ViewBag.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.CurrentPage - 1)"
                               asp-route-searchString="@ViewBag.SearchString"
                               asp-route-filter="@ViewBag.Filter"
                               asp-route-pageSize="@ViewBag.PageSize">
                                <i class="bi bi-chevron-left me-1"></i>Previous
                            </a>
                        </li>

                        @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
                        {
                            <li class="page-item @(p == (int)ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-filter="@ViewBag.Filter"
                                   asp-route-pageSize="@ViewBag.PageSize">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(ViewBag.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.CurrentPage + 1)"
                               asp-route-searchString="@ViewBag.SearchString"
                               asp-route-filter="@ViewBag.Filter"
                               asp-route-pageSize="@ViewBag.PageSize">
                                Next<i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>