@model IEnumerable<BarangayLangkiwaSystem.Models.PurokReportViewModel>

@{
    ViewData["Title"] = "Barangay Statistics Report";
}

<div class="container-fluid py-4 no-print">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mt-2">Purok Summary Statistics</h3>
        </div>

        <div class="d-flex gap-2">
            <div class="input-group shadow-sm" style="width: 250px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" id="purokSearch" class="form-control border-start-0" placeholder="Search Purok..." onkeyup="filterTable()">
            </div>

            <div class="btn-group shadow-sm">
                <button class="btn btn-primary" onclick="handleExcelExport()">
                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                </button>
                <button class="btn btn-secondary" onclick="handlePrint()">
                    <i class="bi bi-printer me-1"></i> Print / PDF
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mx-2">
    <div class="card-body">
        <div class="print-header text-center mb-4">
            <h5 class="mb-0">Republic of the Philippines</h5>
            <h5 class="mb-0">Province of Laguna</h5>
            <h5 class="fw-bold">City of Biñan</h5>
            <h4 class="fw-bold mt-4">BARANGAY LANGKIWA</h4>
            <div style="border-bottom: 2px solid black; width: 100%; margin: 10px 0;"></div>
            <h3 class="fw-bold mt-2">RESIDENT SUMMARY REPORT</h3>
            <p class="text-muted">As of @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        </div>

        <table class="table table-bordered align-middle" id="reportTable">
            <thead class="table-light">
                <tr class="text-center">
                    <th>Purok / Zone</th>
                    <th>Total Residents</th>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total Households</th>
                    <th class="bg-light text-primary">Senior Citizen (60+)</th>
                    <th>Voters</th>
                    <th>New Residents</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-start">@item.PurokName</td>
                        <td class="text-center">@item.TotalResidents</td>
                        <td class="text-center">@item.MaleCount</td>
                        <td class="text-center">@item.FemaleCount</td>
                        <td class="text-center">@item.TotalHousehold</td>
                        <td class="text-center fw-bold">@item.SeniorCount</td>
                        <td class="text-center">@item.RegisteredVoters</td>
                        <td class="text-center">@item.NewResidents</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-dark fw-bold">
                <tr>
                    <td>GRAND TOTAL</td>
                    <td class="text-center">@Model.Sum(i => i.TotalResidents)</td>
                    <td class="text-center">@Model.Sum(i => i.MaleCount)</td>
                    <td class="text-center">@Model.Sum(i => i.FemaleCount)</td>
                    <td class="text-center">@Model.Sum(i => i.TotalHousehold)</td>
                    <td class="text-center">@Model.Sum(i => i.SeniorCount)</td>
                    <td class="text-center">@Model.Sum(i => i.RegisteredVoters)</td>
                    <td class="text-center">@Model.Sum(i => i.NewResidents)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<style>
    /* Standard Web Styling */
    .print-header {
        display: none;
    }

    /* PRINT-ONLY STYLING */
    @@media print {
        .no-print, nav, .sidebar, footer, .btn-group, .breadcrumb, #purokSearch, .input-group {
            display: none !important;
        }

        .print-header {
            display: block !important;
        }

        body {
            background-color: white !important;
        }

        .card, .card-body {
            padding: 0 !important;
            border: none !important;
        }

        .table th, .table td {
            border: 1px solid #000 !important;
            padding: 6px !important;
            color: black !important;
        }

        @@page {
            size: landscape;
            margin: 1cm;
        }
    }
</style>

<script>
    // 1. Helper function to record log in the database
    function recordLog(format) {
        const reportName = "Resident Summary Report";

        // Use fetch to call your ReportsController/LogExport action
        fetch('/Reports/LogExport', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `type=${encodeURIComponent(reportName)}&format=${encodeURIComponent(format)}`
        }).catch(err => console.error("Logging failed:", err));
    }

    // 2. Handle Print Click
    function handlePrint() {
        recordLog("Print/PDF");
        setTimeout(function(){
            window.print();
        }, 100);
    }

    // 3. Handle Excel Click
    function handleExcelExport() {
        recordLog("Excel");
        exportToExcel();
    }

    // Original Excel Logic
    function exportToExcel() {
        let table = document.getElementById("reportTable");
        let html = table.outerHTML;
        let blob = new Blob([html], { type: 'application/vnd.ms-excel' });
        let url = URL.createObjectURL(blob);
        let link = document.createElement("a");
        link.href = url;
        link.download = "Barangay_Langkiwa_Report_" + "@DateTime.Now.ToString("yyyyMMdd")" + ".xls";
        link.click();
    }

    // Original Search Logic
    function filterTable() {
        let input = document.getElementById("purokSearch");
        let filter = input.value.toUpperCase();
        let table = document.getElementById("reportTable");
        let tr = table.getElementsByTagName("tr");

        for (let i = 1; i < tr.length - 1; i++) {
            let td = tr[i].getElementsByTagName("td")[0];
            if (td) {
                let txtValue = td.textContent || td.innerText;
                tr[i].style.display = txtValue.toUpperCase().indexOf(filter) > -1 ? "" : "none";
            }
        }
    }
</script>