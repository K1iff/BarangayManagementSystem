<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Barangay Langkiwa</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
        }

        .sidebar {
            height: 100vh;
            background-color: #1a1c1e;
            width: 260px;
            position: fixed;
            z-index: 1000;
        }

        .nav-link {
            color: #adb5bd;
            padding: 1rem 1.5rem;
            font-weight: 500;
            border-radius: 0;
        }

            .nav-link.active {
                background-color: #0d6efd;
                color: white !important;
            }

            .nav-link:hover:not(.active) {
                color: white;
                background-color: #2c2e30;
            }

        .main-content {
            margin-left: 260px;
            height: 100vh;
            overflow-y: auto;
            padding: 2rem;
        }

        .top-nav {
            background: white;
            border-bottom: 1px solid #dee2e6;
            padding: 1rem 2rem;
            margin-left: 260px;
        }

        .top-nav a:hover .rounded-circle {
            transform: scale(1.1);
            background-color: #0b5ed7 !important; /* Slightly darker blue */
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <div class="sidebar shadow">
            <div class="p-4 text-white">
                <h5 class="fw-bold m-0 text-center">Langkiwa System</h5>
            </div>
            <nav class="nav flex-column mt-4">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index"><i class="bi bi-grid-fill me-3"></i> Dashboard</a>

                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Residents" ? "active" : "")"
                   asp-controller="Residents" asp-action="Index"><i class="bi bi-people-fill me-3"></i> Residents</a>

                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Certificates" ? "active" : "")"
                   asp-controller="Certificates" asp-action="Index"><i class="bi bi-file-earmark-text-fill me-3"></i> Certificates</a>
                    
                @if (ViewBag.Role !="Clerk")
                {
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")"
                   asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-fill me-3"></i> Reports</a>
                }

                @if (ViewBag.Role == "Barangay Captain")
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "UserManagement" ? "active" : "")"
                       asp-controller="UserManagement" asp-action="Index"><i class="bi bi-bar-chart-fill me-3"></i> Manage Accounts</a>
                }
            </nav>

            <div class="mt-auto p-3 border-top border-secondary">
                <a class="nav-link text-danger" asp-controller="Accounts" asp-action="Logout">
                    <i class="bi bi-box-arrow-right me-3"></i> Sign Out
                </a>
            </div>
        </div>

        <div class="w-100">
            <div class="top-nav d-flex justify-content-end align-items-center shadow-sm">
                <div class="text-end me-3">
                    <div class="fw-bold small">@ViewBag.Username</div>
                    <div class="text-muted small" style="font-size: 0.7rem;">@ViewBag.Role</div>
                </div>
                <a asp-controller="UserManagement" asp-action="Profile" class="text-decoration-none">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                        style="width: 40px; height: 40px; cursor: pointer; transition: transform 0.2s;">
                        @ViewBag.Initials
                    </div>
                </a>
            </div>

            <main role="main" class="main-content">
                @RenderBody()
                <footer class="mt-5 pt-4 text-center border-top text-muted small">
                    Version 1.0 | Barangay Langkiwa Resident and Certification Management System
                </footer>
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        let inactivityTime = function () {
            let timer;
            function logout() {
                alert("You have been inactive for 5 minutes. You will be logged out.");
                window.location.href = '@Url.Action("Logout", "Accounts")';
            }

            function resetTimer() {
                clearTimeout(timer);
                timer = setTimeout(logout, 5 * 60 * 1000); // 5 minutes
            }

            // Events to detect activity
            window.onload = resetTimer;
            document.onmousemove = resetTimer;
            document.onkeydown = resetTimer;
            document.onclick = resetTimer;
            document.onscroll = resetTimer;
        };

        inactivityTime();
    </script>
</body>
</html>

