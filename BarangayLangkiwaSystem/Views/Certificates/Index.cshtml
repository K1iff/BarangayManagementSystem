@model IEnumerable<BarangayLangkiwaSystem.Models.CertificateRequest>

@{
    ViewData["Title"] = "Certificate Management";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0">Certificate Management</h2>
        <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">Certification Form</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted d-block fw-bold">Pending Requests</small>
                <h3 class="fw-bold m-0 text-warning">@ViewBag.Pending</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted d-block fw-bold">Approved</small>
                <h3 class="fw-bold m-0 text-success">@ViewBag.Approved</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted d-block fw-bold">Released This Month</small>
                <h3 class="fw-bold m-0 text-primary">@ViewBag.Released</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted d-block fw-bold">Total Requests</small>
                <h3 class="fw-bold m-0">@ViewBag.Total</h3>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-0">
            <ul class="nav nav-tabs card-header-tabs border-0">
                <li class="nav-item"><a class="nav-link active fw-bold" href="#">Pending Requests</a></li>
                <li class="nav-item"><a class="nav-link text-muted" href="#">Released Certificates</a></li>
                <li class="nav-item"><a class="nav-link text-muted" href="#">Monthly Statistics</a></li>
            </ul>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-4">Request ID</th>
                            <th>Resident Name</th>
                            <th>Certificate Type</th>
                            <th>Request Date</th>
                            <th>Purpose</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">@item.RequestId</td>
                                <td class="fw-bold">@item.ResidentName</td>
                                <td>@item.CertificateType</td>
                                <td>@item.RequestDate.ToString("MM/dd/yyyy")</td>
                                <td>@item.Purpose</td>
                                <td><span class="badge bg-warning text-dark px-3">@item.Status</span></td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.RequestId" class="btn btn-sm btn-primary px-3">Approve</a>
                                        <button class="btn btn-sm btn-danger px-3">Reject</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>