@using Microsoft.AspNetCore.Http
@model BarangayLangkiwaSystem.Models.Resident

@{
    ViewData["Title"] = "Report Generation";

    var currentUserName = Context.Session.GetString("Username") ?? "Barangay Staff";
    var currentUserRole = Context.Session.GetString("Role") ?? "Staff";
}

<div class="container-fluid">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary">Reports</a></li>
            <li class="breadcrumb-item active" aria-current="page">Report Generation & Data Export</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-3 mt-4">
        <div class="card-header bg-white py-4 border-0">
            <h4 class="fw-bold m-0 text-center text-primary">
                <i class="bi bi-file-earmark-bar-graph me-2"></i>Report Generation & Data Export
            </h4>
        </div>
        <div class="card-body p-5">
            <form id="reportForm" method="get">
                <div class="mb-4">
                    <label class="form-label fw-bold"><i class="bi bi-calendar3 me-2"></i>Date Range</label>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <input type="date" name="startDate" class="form-control bg-light border-0 py-2 shadow-sm" required />
                            <small class="text-muted">Start Date</small>
                        </div>
                        <div class="col-md-6">
                            <input type="date" name="endDate" class="form-control bg-light border-0 py-2 shadow-sm" required />
                            <small class="text-muted">End Date</small>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold"><i class="bi bi-list-check me-2"></i>Report Type</label>
                    <div class="list-group">
                        <label class="list-group-item d-flex align-items-center bg-light border-0 mb-2 rounded shadow-sm py-3">
                            <input class="form-check-input me-3" type="radio" name="reportType" value="ResidentSummary" checked>
                            <div>
                                <span class="fw-bold d-block">Resident Summary Report</span>
                                <small class="text-muted">Comprehensive list of all registered residents.</small>
                            </div>
                        </label>
                        <label class="list-group-item d-flex align-items-center bg-light border-0 mb-2 rounded shadow-sm py-3">
                            <input class="form-check-input me-3" type="radio" name="reportType" value="CertificateIssuance">
                            <div>
                                <span class="fw-bold d-block">Certificate Issuance Report</span>
                                <small class="text-muted">Summary of all certificates issued within the date range.</small>
                            </div>
                        </label>
                        <label class="list-group-item d-flex align-items-center bg-light border-0 mb-2 rounded shadow-sm py-3">
                            <input class="form-check-input me-3" type="radio" name="reportType" value="ActivityLog">
                            <div>
                                <span class="fw-bold d-block">Activity Report</span>
                                <small class="text-muted">Logs of system activities and user requests.</small>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold"><i class="bi bi-filter-circle me-2"></i>Certificate Type Filter <span class="text-muted small fw-normal">(if Applicable)</span></label>
                    <select name="certType" class="form-select bg-light border-0 py-2 shadow-sm">
                        <option value="">All Certificate Types</option>
                        <option value="Residency">Certificate of Residency</option>
                        <option value="Indigency">Indigency</option>
                        <option value="Clearance">Barangay Clearance</option>
                    </select>
                </div>

                <div class="mb-5">
                    <label class="form-label fw-bold"><i class="bi bi-person-badge me-2"></i>Prepared by:</label>
                    <input type="text" class="form-control bg-light border-0 py-2" value="@($"{currentUserName} ({currentUserRole})")" readonly />
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <button type="button" onclick="submitReport()" class="btn btn-primary px-5 py-2 shadow-sm fw-bold">
                        <i class="bi bi-gear-wide-connected me-2"></i>Generate Report
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-5 py-2">
                        <i class="bi bi-x-circle me-2"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                function submitReport() {
            const form = document.getElementById('reportForm');
            const reportType = document.querySelector('input[name="reportType"]:checked').value;

            if (reportType === "ActivityLog") {
                form.action = '@Url.Action("ActivityReport", "Reports")';
            } else if (reportType === "ResidentSummary") {
                form.action = '@Url.Action("ViewReport", "Reports")';
            } else if (reportType === "CertificateIssuance") {
                // NEW DESTINATION
                form.action = '@Url.Action("CertificateIssuanceReport", "Reports")';
            }

            form.submit();
        }
    </script>
}
