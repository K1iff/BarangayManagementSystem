@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold text-dark">Dashboard Overview</h2>
        <p class="text-muted">Welcome to the Barangay Langkiwa Administrative Portal.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100" style="border-left: 5px solid #0d6efd !important;">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Total Residents</div>
                    <h2 class="fw-bold text-primary">@ViewBag.TotalResidents</h2>
                    <small class="text-success"><i class="bi bi-arrow-up"></i> Population Data</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100" style="border-left: 5px solid #198754 !important;">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Certificates Issued</div>
                    <h2 class="fw-bold text-success">@ViewBag.CertificatesIssued</h2>
                    <small class="text-muted">Released Records</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100" style="border-left: 5px solid #ffc107 !important;">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Pending Requests</div>
                    <h2 class="fw-bold text-warning">@ViewBag.PendingRequests</h2>
                    <small class="text-danger">Action Required</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100" style="border-left: 5px solid #0dcaf0 !important;">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Reports Generated</div>
                    <h2 class="fw-bold text-info">@ViewBag.ReportsGenerated</h2>
                    <small class="text-muted">For LGU Submission</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3">
                    <h5 class="m-0 fw-bold">Recent System Activity</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">No recent activities to display. Database connection pending.</p>
                </div>
            </div>
        </div>
    </div>
</div>