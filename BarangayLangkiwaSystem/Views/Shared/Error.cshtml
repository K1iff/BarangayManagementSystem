@model ErrorViewModel
@{
    ViewData["Title"] = "System Error";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-5 mx-auto" style="max-width: 600px;">
        <div class="rounded-circle bg-danger bg-opacity-10 text-danger mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
            <i class="bi bi-exclamation-octagon-fill fs-2"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Something Went Wrong</h3>
        <p class="text-muted mb-4">
            An unexpected error occurred while processing your request. Our system logged this issue safely to prevent data loss.
        </p>

        @if (Model != null && Model.ShowRequestId)
        {
            <div class="alert alert-light border small text-muted mb-4">
                <strong>Tracking Request ID:</strong> <code>@Model.RequestId</code>
            </div>
        }

        <div class="d-flex justify-content-center gap-2">
            <a asp-action="Index" asp-controller="Home" class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-grid-fill me-2"></i>Return to Dashboard
            </a>
            <a href="javascript:history.back()" class="btn btn-light border px-4">
                <i class="bi bi-arrow-left me-2"></i>Go Back
            </a>
        </div>
    </div>
</div>
