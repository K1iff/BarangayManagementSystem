@model IEnumerable<BarangayLangkiwaSystem.Models.CertificationLog>

@{
    ViewData["Title"] = "Certificate Management";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0">Certificate Management</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">Certification Form</a>

            <a asp-action="ViewLog" class="btn btn-info px-4 shadow-sm">View Log</a>

            <button class="btn btn-secondary px-4 shadow-sm" onclick="selectAndPrintFile();">Print</button>

            @if (ViewBag.Role == "Barangay Captain")
            {
                <a asp-action="AddType" class="btn btn-secondary px-4 shadow-sm">Add Certificate Type</a>
            }
        </div>
    </div>

   <div class="row mb-4">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center">
                <i class="bi bi-funnel me-2 text-muted"></i>
                <h5 class="m-0 fw-bold">Recent Requests</h5>
                <form method="get" asp-action="Index">
                    <select name="filter" class="form-select" onchange="this.form.submit()">
                        <option value="All" selected="@(ViewBag.Filter == "All")">All Time</option>
                        <option value="Today" selected="@(ViewBag.Filter == "Today")">Today</option>
                        <option value="Week" selected="@(ViewBag.Filter == "Week")">This Week</option>
                        <option value="Month" selected="@(ViewBag.Filter == "Month")">This Month</option>
                        <option value="LastMonth" selected="@(ViewBag.Filter == "LastMonth")">Last Month</option>
                    </select>
                </form>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100" style="border-left: 5px solid #198754 !important;">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Approved</div>
                    <h2 class="fw-bold text-success">@ViewBag.Approved</h2>
                    <small class="text-muted"><i class="bi bi-check-circle-fill"></i> Validated Requests</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100" style="border-left: 5px solid #0d6efd !important;">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Released (Month)</div>
                    <h2 class="fw-bold text-primary">@ViewBag.Released</h2>
                    <small class="text-muted"><i class="bi bi-send-fill"></i> Issued Certificates</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100" style="border-left: 5px solid #212529 !important;">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Total Requests</div>
                    <h2 class="fw-bold text-dark">@ViewBag.Total</h2>
                    <small class="text-muted"><i class="bi bi-file-earmark-text"></i> All Records</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-12"> <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold mb-4">Certificates Issued by Type</h5>
                    <canvas id="certChart" height = "250"></canvas>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold m-0 text-dark">Certificate Issuance Records</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="small text-uppercase text-muted">
                                    <th class="ps-4">Cert ID</th>
                                    <th>Resident</th>
                                    <th>Certificate Type</th>
                                    <th>Purpose</th>
                                    <th>Date Issued</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="ps-4 text-muted small">#@item.CertId</td>
                                            <td class="fw-bold text-dark">@item.IssuedBy</td>
                                            <td><span class="badge bg-light text-dark border">@item.ReferenceCode</span></td>
                                            <td class="small text-muted">@item.purpose</td>
                                            <td class="small">@item.date_issued.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @if (item.status == "Approved")
                                                {
                                                    <span class="badge bg-success px-2 py-1">Approved</span>
                                                }
                                                else if (item.status == "Disapproved")
                                                {
                                                    <span class="badge bg-danger px-2 py-1">Disapproved</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark px-2 py-1">Pending</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">No certificate records found for this period.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 0)
                {
                    <div class="card-footer bg-white py-3 border-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted ps-2">
                                Showing @(Model.Any() ? (ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1 : 0) to @Math.Min((int)ViewBag.CurrentPage * (int)ViewBag.PageSize, (int)ViewBag.TotalCount) of @ViewBag.TotalCount certificates
                            </small>

                            <nav aria-label="Certificates pagination">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(ViewBag.HasPreviousPage ? "" : "disabled")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                                           asp-route-filter="@ViewBag.Filter"
                                           asp-route-pageSize="@ViewBag.PageSize">
                                            <i class="bi bi-chevron-left me-1"></i>Previous
                                        </a>
                                    </li>

                                    @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
                                    {
                                        <li class="page-item @(p == (int)ViewBag.CurrentPage ? "active" : "")">
                                            <a class="page-link"
                                               asp-action="Index"
                                               asp-route-page="@p"
                                               asp-route-filter="@ViewBag.Filter"
                                               asp-route-pageSize="@ViewBag.PageSize">
                                                @p
                                            </a>
                                        </li>
                                    }

                                    <li class="page-item @(ViewBag.HasNextPage ? "" : "disabled")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                                           asp-route-filter="@ViewBag.Filter"
                                           asp-route-pageSize="@ViewBag.PageSize">
                                            Next<i class="bi bi-chevron-right ms-1"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@section Scripts{

<script>
    let inactivityTime = function () {
        let time;
        window.onload = resetTimer;
        document.onmousemove = resetTimer;
        document.onkeypress = resetTimer;

        function logout() {
            alert("You have been logged out due to inactivity.");
            window.location.href = '@Url.Action("Logout", "Accounts")';
        }

        function resetTimer() {
            clearTimeout(time);
            time = setTimeout(logout, 5 * 60 * 1000); // 5 minutes
        }
    };

    inactivityTime();
</script>

<script>
    var ctx = document.getElementById('certChart').getContext('2d');
    var certChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
            datasets: [{
                label: 'Certificates Issued',
                data: @Html.Raw(Json.Serialize(ViewBag.ChartValues)),
                backgroundColor: '#0d6efd', // Bootstrap primary color
                borderRadius: 5
            }]
        },
        options: {
            responsive: true,
            scales: { y: { beginAtZero: true } }
        }
    });
</script>

<script>
function selectAndPrintFile() {
    // Create a hidden file input
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.doc,.docx,.pdf,.txt'; // accept common document types

    input.onchange = e => {
        const file = e.target.files[0];
        if (!file) return;

        // For PDFs: open in new tab
        if (file.type === "application/pdf") {
            const url = URL.createObjectURL(file);
            const printWindow = window.open(url);
            printWindow.onload = () => printWindow.print();
        } else {
            // For Word / text files, we can read as text and open in new window
            const reader = new FileReader();
            reader.onload = function(ev) {
                const w = window.open("");
                w.document.write(`<pre>${ev.target.result}</pre>`);
                w.document.close();
                w.focus();
                w.print();
            };
            reader.readAsText(file);
        }
    };

    input.click(); // trigger file dialog
}
</script>

}