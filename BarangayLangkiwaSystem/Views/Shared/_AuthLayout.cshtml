<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Barangay Langkiwa</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body.auth-bg {
            background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)), url('/images/entry_bg.jpg') no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
        }

        .auth-logo {
            width: 90px;
            height: 90px;
            object-fit: contain;
        }
    </style>
</head>
<body class="auth-bg d-flex align-items-center py-4">
    <div class="container">
        <div class="row align-items-center justify-content-center g-4">
            <!-- Left Branding Panel -->
            <div class="col-lg-6 text-white text-center text-lg-start pe-lg-4">
                <div class="d-flex align-items-center justify-content-center justify-content-lg-start gap-3 mb-4">
                    <img src="~/images/binan_logo.png" alt="City of Biñan Seal" class="auth-logo shadow-sm rounded-circle bg-white p-1" />
                    <img src="~/images/langkiwa_logo.jpg" alt="Barangay Langkiwa Seal" class="auth-logo shadow-sm rounded-circle bg-white p-1" />
                </div>
                <h1 class="display-4 fw-bold text-white mb-2">Barangay Langkiwa</h1>
                <p class="fs-4 fw-bold text-white mb-0">Resident and Certification Management System</p>
            </div>

            <!-- Right Content Panel -->
            <div class="col-lg-5 col-md-8 col-sm-10">
                <div class="mx-auto w-100">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
